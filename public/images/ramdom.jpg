    }
    function pendingHandler(resourceName, encodedOptionsKey) {
      if (!window.__PWS_RESOURCE_PENDING_BEFORE_INIT__[resourceName]) {
        window.__PWS_RESOURCE_PENDING_BEFORE_INIT__[resourceName] = new Set();
